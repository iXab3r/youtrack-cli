{
  "name": "@eyeauras/youtrack-cli",
  "version": "0.9.0",
  "description": "AI-friendly YouTrack CLI built with AI CLI Factory.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "youtrack-cli": "dist/src/bin.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/bin.js",
    "test:compiled": "node --test dist/tests/*.test.js",
    "pretest:integration": "npm run build",
    "test:integration": "node dist/integration-tests/profile-proof.js",
    "prepack": "npm run build",
    "test": "npm run build && npm run test:compiled",
    "check": "npm test",
    "test:package": "node scripts/test-package.mjs",
    "test:registry": "node scripts/test-package.mjs --registry",
    "test:release": "node --test scripts/test-release.mjs",
    "test:coverage": "node scripts/rest-api-audit/verify.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@eyeauras/cli-factory": "0.7.1",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "msw": "^2.11.0",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iXab3r/youtrack-cli.git"
  },
  "homepage": "https://github.com/iXab3r/youtrack-cli",
  "bugs": {
    "url": "https://github.com/iXab3r/youtrack-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/src"
  ],
  "packageManager": "npm@11.20.0"
}
